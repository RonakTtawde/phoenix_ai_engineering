{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemini/gemini-3-pro-preview-pt",
  "small_model": "gemini/gemini-2.0-flash",
  "default_agent": "orchestrator",
  "logLevel": "INFO",
  "instructions": ["AGENTS.md", "shared/contracts/*.md"],
  "agent": {
    "orchestrator": {
      "description": "Central coordinator responsible for task routing, agent selection, dependency management, validation gates, handoffs, and workflow completion.",
      "mode": "primary",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "ask",
        "bash": {
          "git *": "allow",
          "*": "ask"
        }
      }
    },
    "analysis": {
      "description": "Analyzes project architecture, codebase structure, dependencies, implementation status, risks, and technical gaps without modifying project artifacts.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "deny",
        "bash": {
          "git status": "allow",
          "git log *": "allow",
          "ls *": "allow",
          "*": "ask"
        }
      }
    },
    "planning": {
      "description": "Converts requirements and findings into structured, prioritized, dependency-aware tasks.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask"
        }
      }
    },
    "backend": {
      "description": "Develop and modify backend services, business logic, persistence, and integrations.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "npm *": "allow",
          "yarn *": "allow",
          "cargo *": "allow",
          "*": "ask"
        }
      }
    },
    "frontend": {
      "description": "Develop and modify frontend components, UI logic, and client-side integrations.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "npm *": "allow",
          "yarn *": "allow",
          "*": "ask"
        }
      }
    },
    "debugging": {
      "description": "Diagnose defects and implement minimal verified fixes within assigned scope.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "npm *": "allow",
          "yarn *": "allow",
          "*": "ask"
        }
      }
    },
    "devops": {
      "description": "Manage infrastructure, CI/CD pipelines, deployment, and operational concerns.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "docker *": "allow",
          "kubectl *": "allow",
          "terraform *": "allow",
          "*": "ask"
        }
      }
    },
    "testing": {
      "description": "Design and execute test strategies, write test cases, and validate correctness.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "npm *": "allow",
          "yarn *": "allow",
          "pytest *": "allow",
          "jest *": "allow",
          "*": "ask"
        }
      }
    },
    "reviewer": {
      "description": "Review code changes, enforce quality standards, and validate compliance.",
      "mode": "subagent",
      "model": "gemini/gemini-3-pro-preview-pt",
      "permission": {
        "edit": "deny",
        "bash": {
          "git diff *": "allow",
          "git log *": "allow",
          "*": "ask"
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "git status": "allow",
      "git log *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "*": "ask"
    },
    "external_directory": {
      "/mnt/d/phoenix_ai_engineering/*": "allow"
    }
  }
}
